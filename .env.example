# TheDobra — desenvolvimento local
APP_ENV=development
APP_HTTP_ADDR=:8080
APP_PUBLIC_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:3010
# Produção (Nginx, um só domínio — ver deploy/nginx/app.thedobra.cc.conf):
# APP_PUBLIC_URL=https://app.thedobra.cc
# WEB_ORIGIN=https://app.thedobra.cc
# OAuth callback = APP_PUBLIC_URL + /api/v1/auth/oauth/<provider>/callback
# Next.js: browser chama /api/v1 no mesmo host (sem NEXT_PUBLIC_API_URL).
# Build/start web: NEXT_PUBLIC_APP_URL=https://app.thedobra.cc API_PROXY_URL=http://127.0.0.1:8080 PORT=3010

# JWT / crypto — substitua fora do ambiente local
JWT_SECRET=thedobra-dev-jwt-secret-change-me-32b
ENCRYPTION_KEY=thedobra-dev-enc-key-32bytes-ok!

POSTGRES_DSN=postgres://thedobra:thedobra@localhost:5432/thedobra?sslmode=disable
REDIS_ADDR=localhost:6379
CLICKHOUSE_ADDR=localhost:9009
CLICKHOUSE_DATABASE=thedobra
CLICKHOUSE_USER=thedobra
CLICKHOUSE_PASSWORD=thedobra

MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=thedobra
MINIO_SECRET_KEY=thedobra-secret
MINIO_BUCKET=thedobra
MINIO_USE_SSL=false

KAFKA_BROKERS=localhost:9092

# Portas publicadas no host pelo docker-compose (defaults = dev local).
# Só precisa de as definir se a porta já estiver ocupada no host.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# CLICKHOUSE_HTTP_PORT=8123
# CLICKHOUSE_NATIVE_PORT=9009
# MINIO_API_PORT=9010
# MINIO_CONSOLE_PORT=9011
# KAFKA_PORT=9092
# REDPANDA_ADMIN_PORT=9644
#
# VPS: se 5432 já estiver ocupado
# POSTGRES_PORT=5433
# POSTGRES_DSN=postgres://thedobra:thedobra@127.0.0.1:5433/thedobra?sslmode=disable
#
# Redis 6379, Kafka 9092 e ClickHouse 8123 também são portas comuns —
# se o bind falhar, defina REDIS_PORT / KAFKA_PORT / CLICKHOUSE_HTTP_PORT
# e actualize REDIS_ADDR / KAFKA_BROKERS / o cliente HTTP em conformidade.
# A API e o web NÃO estão neste compose: precisam da porta no host
# (ou de correr na mesma rede Docker, usando hostname `postgres` na DSN).

# Opcional. Vazio = planeador determinístico + consultas reais.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OAuth / OIDC (Google, GitHub, IdP empresarial)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Stripe billing vivo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=

# Alertas e convites (vazio = só loga no stdout da API)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TheDobra <noreply@thedobra.dev>
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
